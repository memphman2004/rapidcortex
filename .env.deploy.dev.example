# Copy to .env.deploy.dev (gitignored) and set full Secrets Manager ARNs for INCLUDE_DATA_LAYER_NESTED_STACK=false.
# Obtain with e.g.: aws secretsmanager describe-secret --secret-id rapid-cortex/billing/payment-instructions --query ARN --output text
FLAT_DATA_LAYER_BILLING_PAYMENT_INSTRUCTIONS_SECRET_ARN=
FLAT_DATA_LAYER_BILLING_SES_CREDENTIALS_SECRET_ARN=

