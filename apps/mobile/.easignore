# EAS archive root is the git repo root. Paths are relative to that root.
# A local .easignore replaces .gitignore for upload — keep this comprehensive.

# Other apps / infra not needed for the mobile native build
/apps/api/
/apps/web/
/apps/marketing/
/apps/desktop-macos/
/apps/desktop-windows/
/infra/
/scripts/
/docs/
/tools/
/.cursor/
/.git/
/.github/
/.rapid-cortex-sam-build/
/.sam-lean-build/
/prod
/agent-transcripts/
/Rapid Cortex Internal Docs/
Rapid Cortex Internal Docs/
/web-source-prod.zip
/web-source-*.zip
*.zip
*.mov
*.mp4
*.mp3
*.pptx
*.docx
/.sam-build-*/
/.sam-build-riq-pipeline-*/
.sam-build-*/
.sam-build-riq-pipeline-*/
/ziicMOdT
/ziKUSoeO
/packages/security/
/packages/integrations/
/packages/protocols/
/packages/maps/
/packages/api/
/packages/desktop/

# Dependencies & build artifacts (reinstalled/built on EAS workers)
**/node_modules/
**/.expo/
**/dist/
!/packages/shared/dist/
!/packages/shared/dist/**
**/build/
**/.next/
**/coverage/
**/.turbo/
**/*.tgz
**/ios/Pods/
**/android/.gradle/
**/android/app/build/

# Env / secrets / local
**/.env
**/.env.*
!**/.env.example
**/google-play-key.json
**/Secrets.plist
**/appsettings.Local.json
**/.DS_Store
**/npm-debug.log*
**/*.log
