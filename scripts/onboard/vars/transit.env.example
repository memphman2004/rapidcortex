# Copy to transit.env (gitignored) and fill. Then:
#   source scripts/env-api-dev.sh
#   bash scripts/onboard/transit.sh scripts/onboard/vars/transit.env

VERTICAL=transit
AGENCY_ID=al-hoover-transit
AGENCY_NAME="Example Transit Authority"
ORG_CODE=ETA
STATE=AL
CITY=Hoover
REGION_NAME=Birmingham
TIMEZONE=America/Chicago
ADMIN_EMAIL=transit-admin@example.gov
PRIMARY_CONTACT_NAME="Transit Safety Director"
PRIMARY_CONTACT_EMAIL=transit-admin@example.gov
ONBOARD_ADMIN_PASSWORD=

# Optional
# SEED_BILLING=0
# DRY_RUN=1
# EXTRA_USERS_JSON='[{"email":"transit-supervisor@example.gov","role":"transit_supervisor"}]'
