# Copy to psap.env (gitignored) and fill. Then:
#   source scripts/env-api-dev.sh
#   bash scripts/onboard/psap.sh scripts/onboard/vars/psap.env
#
# INTEGRATION_MODE may be cad_read_only. Never bidirectional (CAD write-back).

VERTICAL=psap
AGENCY_TYPE=county
AGENCY_ID=ga-muscogee-911
AGENCY_NAME="Muscogee County 911"
ORG_CODE=MC911
STATE=GA
CITY=Columbus
REGION_NAME=West Central Georgia
TIMEZONE=America/New_York
ADMIN_EMAIL=agency-admin@example.gov
PRIMARY_CONTACT_NAME="ECC Director"
PRIMARY_CONTACT_EMAIL=agency-admin@example.gov
ONBOARD_ADMIN_PASSWORD=
INTEGRATION_MODE=mock_adapters

# Optional
# INTEGRATION_MODE=cad_read_only
# SEED_BILLING=0
# DRY_RUN=1
# EXTRA_USERS_JSON='[{"email":"dispatcher@example.gov","role":"dispatcher"},{"email":"supervisor@example.gov","role":"supervisor"}]'
