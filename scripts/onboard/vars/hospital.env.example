# Copy to hospital.env (gitignored) and fill. Then:
#   source scripts/env-api-dev.sh
#   bash scripts/onboard/hospital.sh scripts/onboard/vars/hospital.env
#
# Agency type is municipality (schema has no hospital type). Product vertical=hospital.

VERTICAL=hospital
AGENCY_ID=ga-athens-regional
AGENCY_NAME="Example Regional Medical Center"
ORG_CODE=ERMC
HOSPITAL_ID=hosp-ermc
STATE=GA
CITY=Athens
REGION_NAME=Northeast Georgia
TIMEZONE=America/New_York
ADMIN_EMAIL=hospital-admin@example.org
PRIMARY_CONTACT_NAME="Emergency Department Administrator"
PRIMARY_CONTACT_EMAIL=hospital-admin@example.org
ONBOARD_ADMIN_PASSWORD=

# Optional
# SEED_BILLING=0
# DRY_RUN=1
# EXTRA_USERS_JSON='[{"email":"er-staff@example.org","role":"hospitalstaff"}]'
