# Copy to call-assist.env (gitignored) and fill. Then:
#   source scripts/env-api-dev.sh
#   bash scripts/onboard/call-assist.sh scripts/onboard/vars/call-assist.env
#
# Nexiq (non-emergency call center). NOT a 911 dispatch console.
# After day-0, complete Lex/Connect provision via POST /api/call-assist/onboarding.

VERTICAL=call_assist
AGENCY_ID=test-call-assist-example
AGENCY_NAME="Example City Non-Emergency Center"
# Short display name used in AI disclosure and IVR greetings
AGENCY_SHORT_NAME="Example City"
ORG_CODE=EXMP
STATE=GA
CITY=Example City
REGION_NAME=Georgia
TIMEZONE=America/New_York

# ── Day-one seats (ordered: admin → supervisor → operator) ──
ADMIN_EMAIL=nexiq-admin@example.com
# Leave blank to skip provisioning that seat today
SUPERVISOR_EMAIL=
OPERATOR_EMAIL=
PRIMARY_CONTACT_NAME="Non-Emergency Center Director"
PRIMARY_CONTACT_EMAIL=nexiq-admin@example.com
ONBOARD_ADMIN_PASSWORD=

# Optional
# AGENCY_TYPE=municipality
# INTEGRATION_MODE=mock_adapters
# PLAN_ID=command
# SEED_BILLING=0
# DRY_RUN=1
# EXTRA_USERS_JSON='[{"email":"operator2@example.com","role":"call_assist_operator"}]'
