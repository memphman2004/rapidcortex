# Copy to venue.env (gitignored) and fill. Then:
#   source scripts/env-api-dev.sh
#   bash scripts/onboard/venue.sh scripts/onboard/vars/venue.env

VERTICAL=venue
AGENCY_ID=test-venue-mbs
AGENCY_NAME="Mercedes-Benz Stadium Security"
ORG_CODE=MBS
STATE=GA
CITY=Atlanta
REGION_NAME=Metro Atlanta
TIMEZONE=America/New_York
# stadium | arena | convention_center | amphitheater | fairgrounds | other
VENUE_TYPE=stadium

# ── Day-one seats (ordered: admin → supervisor → security → operator → guest) ──
ADMIN_EMAIL=venue-admin@example.com
# Leave blank to skip provisioning that seat today
SUPERVISOR_EMAIL=
SECURITY_EMAIL=
OPERATOR_EMAIL=
GUEST_EMAIL=
PRIMARY_CONTACT_NAME="Security Director"
PRIMARY_CONTACT_EMAIL=venue-admin@example.com
ONBOARD_ADMIN_PASSWORD=

# Optional
# AGENCY_TYPE=venue
# INTEGRATION_MODE=mock_adapters
# PLAN_ID=command
# SEED_BILLING=0
# SEED_PLACEHOLDER_QR=0
# DRY_RUN=1
# EXTRA_USERS_JSON='[{"email":"floor-lead@example.com","role":"venue_security"}]'
