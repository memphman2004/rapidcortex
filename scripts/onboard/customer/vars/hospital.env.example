# Copy to hospital.env (gitignored) and fill. Then:
#   source scripts/env-api-dev.sh
#   bash scripts/onboard/hospital.sh scripts/onboard/vars/hospital.env

VERTICAL=hospital
AGENCY_ID=test-hospital-grady
AGENCY_NAME="Grady Memorial Hospital"
ORG_CODE=GRADY
HOSPITAL_ID=hosp-grady
STATE=GA
CITY=Atlanta
REGION_NAME=Metro Atlanta
TIMEZONE=America/New_York

# ── Day-one seats (ordered: admin → coordinator → staff) ──
ADMIN_EMAIL=hospital-admin@example.com
# Leave blank to skip provisioning that seat today
COORDINATOR_EMAIL=
STAFF_EMAIL=
PRIMARY_CONTACT_NAME="Hospital Emergency Manager"
PRIMARY_CONTACT_EMAIL=hospital-admin@example.com
ONBOARD_ADMIN_PASSWORD=

# Optional
# AGENCY_TYPE=municipality
# INTEGRATION_MODE=mock_adapters
# PLAN_ID=command
# SEED_BILLING=0
# DRY_RUN=1
# EXTRA_USERS_JSON='[{"email":"ed-nurse@example.com","role":"hospitalstaff"}]'
