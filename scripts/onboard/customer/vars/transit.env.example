# Copy to transit.env (gitignored) and fill. Then:
#   source scripts/env-api-dev.sh
#   bash scripts/onboard/transit.sh scripts/onboard/vars/transit.env

VERTICAL=transit
AGENCY_ID=test-transit-marta
AGENCY_NAME="MARTA Transit Authority"
ORG_CODE=MARTA
STATE=GA
CITY=Atlanta
REGION_NAME=Metro Atlanta
TIMEZONE=America/New_York

# ── Day-one seats (ordered: admin → supervisor → security → operator) ──
ADMIN_EMAIL=transit-admin@example.com
# Leave blank to skip provisioning that seat today
SUPERVISOR_EMAIL=
SECURITY_EMAIL=
OPERATOR_EMAIL=
PRIMARY_CONTACT_NAME="Transit Security Director"
PRIMARY_CONTACT_EMAIL=transit-admin@example.com
ONBOARD_ADMIN_PASSWORD=

# Optional
# AGENCY_TYPE=transit
# INTEGRATION_MODE=mock_adapters
# PLAN_ID=command
# SEED_BILLING=0
# SEED_PLACEHOLDER_QR=0
# DRY_RUN=1
# EXTRA_USERS_JSON='[{"email":"driver2@example.com","role":"transit_operator"}]'
