{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFormationRapidCortexStacks",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:CreateStack",
        "cloudformation:DeleteChangeSet",
        "cloudformation:DeleteStack",
        "cloudformation:DescribeChangeSet",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResource",
        "cloudformation:DescribeStackResources",
        "cloudformation:DescribeStacks",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:ListChangeSets",
        "cloudformation:ListStackResources",
        "cloudformation:UpdateStack",
        "cloudformation:ValidateTemplate"
      ],
      "Resource": [
        "arn:aws:cloudformation:us-east-1:158961537080:stack/rapid-cortex-*/*",
        "arn:aws:cloudformation:us-east-1:aws:transform/Serverless-2016-10-31"
      ]
    },
    {
      "Sid": "CloudFormationDiscovery",
      "Effect": "Allow",
      "Action": ["cloudformation:DescribeStacks", "cloudformation:ListStacks"],
      "Resource": "*"
    },
    {
      "Sid": "SamArtifactBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:GetBucketLocation",
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket",
        "s3:PutBucketPolicy",
        "s3:PutBucketVersioning",
        "s3:PutEncryptionConfiguration",
        "s3:PutLifecycleConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::aws-sam-cli-managed-default-samclisourcebucket-*",
        "arn:aws:s3:::aws-sam-cli-managed-default-samclisourcebucket-*/*",
        "arn:aws:s3:::rapid-cortex-sam-artifacts-*",
        "arn:aws:s3:::rapid-cortex-sam-artifacts-*/*"
      ]
    },
    {
      "Sid": "LambdaApiGatewayDynamoCognitoLogs",
      "Effect": "Allow",
      "Action": [
        "lambda:*",
        "apigateway:*",
        "dynamodb:*",
        "cognito-idp:*",
        "sns:*",
        "ses:*",
        "logs:*",
        "events:*",
        "application-autoscaling:*",
        "cloudwatch:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AcmRequestCertificate",
      "Effect": "Allow",
      "Action": ["acm:RequestCertificate"],
      "Resource": "*"
    },
    {
      "Sid": "AcmManageIssuedCertificates",
      "Effect": "Allow",
      "Action": [
        "acm:DescribeCertificate",
        "acm:ListTagsForCertificate",
        "acm:AddTagsToCertificate",
        "acm:DeleteCertificate",
        "acm:RemoveTagsForCertificate"
      ],
      "Resource": "arn:aws:acm:us-east-1:158961537080:certificate/*"
    },
    {
      "Sid": "Route53RecordsInHostedZone",
      "Effect": "Allow",
      "Action": ["route53:ChangeResourceRecordSets", "route53:ListResourceRecordSets"],
      "Resource": "arn:aws:route53:::hostedzone/*"
    },
    {
      "Sid": "Route53GlobalReads",
      "Effect": "Allow",
      "Action": [
        "route53:GetChange",
        "route53:ListHostedZones",
        "route53:GetHostedZone",
        "route53:ListHostedZonesByName"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IamRolesForSamLambda",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:PassRole",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": ["arn:aws:iam::158961537080:role/rapid-cortex-*"]
    },
    {
      "Sid": "RapidCortexDeployManagedPolicyLifecycle",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:TagPolicy",
        "iam:UntagPolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::158961537080:policy/rapid-cortex-*",
        "arn:aws:iam::158961537080:role/rapid-cortex-*"
      ]
    },
    {
      "Sid": "S3AssetsBucketFromStack",
      "Effect": "Allow",
      "Action": ["s3:*"],
      "Resource": ["arn:aws:s3:::rapid-cortex-*", "arn:aws:s3:::rapid-cortex-*/*"]
    },
    {
      "Sid": "MarketingCloudFrontInvalidation",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation",
        "cloudfront:ListInvalidations"
      ],
      "Resource": "arn:aws:cloudfront::158961537080:distribution/EWZ286WS69KX1"
    },
    {
      "Sid": "WebEcrDescribe",
      "Effect": "Allow",
      "Action": ["ecr:DescribeRepositories", "ecr:GetAuthorizationToken"],
      "Resource": "*"
    },
    {
      "Sid": "WebCodeBuildDeploy",
      "Effect": "Allow",
      "Action": [
        "codebuild:BatchGetProjects",
        "codebuild:BatchGetBuilds",
        "codebuild:StartBuild",
        "codebuild:ListBuildsForProject"
      ],
      "Resource": "arn:aws:codebuild:us-east-1:158961537080:project/rapid-cortex-web-build-*"
    },
    {
      "Sid": "WebEcsDeployMutate",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateService",
        "ecs:RegisterTaskDefinition",
        "ecs:CreateService"
      ],
      "Resource": [
        "arn:aws:ecs:us-east-1:158961537080:service/rapid-cortex-v2-web-prod/*",
        "arn:aws:ecs:us-east-1:158961537080:service/rapid-cortex-web-*/*",
        "arn:aws:ecs:us-east-1:158961537080:task-definition/rapid-cortex-v2-web-prod:*",
        "arn:aws:ecs:us-east-1:158961537080:task-definition/rapid-cortex-web-*:*"
      ]
    },
    {
      "Sid": "WebEcsDeployDescribe",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeServices",
        "ecs:DescribeTasks",
        "ecs:ListTasks",
        "ecs:DescribeTaskDefinition"
      ],
      "Resource": [
        "arn:aws:ecs:us-east-1:158961537080:service/rapid-cortex-v2-web-prod/*",
        "arn:aws:ecs:us-east-1:158961537080:service/rapid-cortex-web-*/*",
        "arn:aws:ecs:us-east-1:158961537080:task/rapid-cortex-v2-web-prod/*",
        "arn:aws:ecs:us-east-1:158961537080:task/rapid-cortex-web-*/*",
        "arn:aws:ecs:us-east-1:158961537080:task-definition/rapid-cortex-v2-web-prod:*",
        "arn:aws:ecs:us-east-1:158961537080:task-definition/rapid-cortex-web-*:*"
      ]
    },
    {
      "Sid": "WebEcsClusterDiscovery",
      "Effect": "Allow",
      "Action": ["ecs:DescribeClusters", "ecs:ListServices"],
      "Resource": [
        "arn:aws:ecs:us-east-1:158961537080:cluster/rapid-cortex-v2-web-prod",
        "arn:aws:ecs:us-east-1:158961537080:cluster/rapid-cortex-web-*"
      ]
    },
    {
      "Sid": "WebCfnStackRead",
      "Effect": "Allow",
      "Action": ["cloudformation:DescribeStacks"],
      "Resource": [
        "arn:aws:cloudformation:us-east-1:158961537080:stack/rapid-cortex-web-*/*",
        "arn:aws:cloudformation:us-east-1:158961537080:stack/rapid-cortex-v2-web-*/*"
      ]
    },
    {
      "Sid": "AppCloudFrontInvalidation",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation",
        "cloudfront:ListInvalidations"
      ],
      "Resource": "arn:aws:cloudfront::158961537080:distribution/*"
    },
    {
      "Sid": "MapboxTokenSsmRead",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter"],
      "Resource": "arn:aws:ssm:us-east-1:158961537080:parameter/rapidcortex/prod/mapbox/public-token"
    }
  ]
}
