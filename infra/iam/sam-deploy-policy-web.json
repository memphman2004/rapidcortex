{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MarketingCfInval",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation",
        "cloudfront:ListInvalidations"
      ],
      "Resource": "arn:aws:cloudfront::REPLACE_ACCOUNT_ID:distribution/EWZ286WS69KX1"
    },
    {
      "Sid": "WebEcrDescribe",
      "Effect": "Allow",
      "Action": ["ecr:DescribeRepositories", "ecr:GetAuthorizationToken"],
      "Resource": "*"
    },
    {
      "Sid": "WebEcrCreate",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:PutLifecyclePolicy",
        "ecr:TagResource"
      ],
      "Resource": "arn:aws:ecr:REPLACE_REGION:REPLACE_ACCOUNT_ID:repository/rapid-cortex-web-*"
    },
    {
      "Sid": "WebPipelineSourceUpload",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::rapid-cortex-web-pipeline-*",
        "arn:aws:s3:::rapid-cortex-web-pipeline-*/*"
      ]
    },
    {
      "Sid": "WebCodeBuild",
      "Effect": "Allow",
      "Action": [
        "codebuild:BatchGetProjects",
        "codebuild:BatchGetBuilds",
        "codebuild:StartBuild",
        "codebuild:ListBuildsForProject"
      ],
      "Resource": "arn:aws:codebuild:REPLACE_REGION:REPLACE_ACCOUNT_ID:project/rapid-cortex-web-build-*"
    },
    {
      "Sid": "WebEcsDeregisterTaskDefinition",
      "Effect": "Allow",
      "Action": ["ecs:DeregisterTaskDefinition"],
      "Resource": "*"
    },
    {
      "Sid": "WebEcsMutate",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateService",
        "ecs:RegisterTaskDefinition",
        "ecs:CreateService"
      ],
      "Resource": [
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:service/rapid-cortex-v2-web-*/*",
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:service/rapid-cortex-web-*/*",
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:task-definition/rapid-cortex-v2-web-*:*",
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:task-definition/rapid-cortex-web-*:*"
      ]
    },
    {
      "Sid": "WebEcsDescribeTaskDefinition",
      "Effect": "Allow",
      "Action": ["ecs:DescribeTaskDefinition"],
      "Resource": "*"
    },
    {
      "Sid": "WebEcsDescribe",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeServices",
        "ecs:DescribeTasks",
        "ecs:ListTasks"
      ],
      "Resource": [
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:cluster/rapid-cortex-v2-web-*",
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:cluster/rapid-cortex-web-*",
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:container-instance/rapid-cortex-v2-web-*/*",
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:container-instance/rapid-cortex-web-*/*",
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:service/rapid-cortex-v2-web-*/*",
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:service/rapid-cortex-web-*/*",
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:task/rapid-cortex-v2-web-*/*",
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:task/rapid-cortex-web-*/*"
      ]
    },
    {
      "Sid": "WebEcsClusters",
      "Effect": "Allow",
      "Action": ["ecs:DescribeClusters", "ecs:ListServices"],
      "Resource": [
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:cluster/rapid-cortex-v2-web-*",
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:cluster/rapid-cortex-web-*"
      ]
    },
    {
      "Sid": "WebEcsExecuteCommand",
      "Effect": "Allow",
      "Action": ["ecs:ExecuteCommand"],
      "Resource": [
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:task/rapid-cortex-v2-web-*/*",
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:task/rapid-cortex-web-*/*"
      ],
      "Condition": {
        "StringEquals": {
          "ecs:cluster": [
            "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:cluster/rapid-cortex-v2-web-prod",
            "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:cluster/rapid-cortex-web-prod"
          ]
        }
      }
    },
    {
      "Sid": "WebCfnStackRead",
      "Effect": "Allow",
      "Action": ["cloudformation:DescribeStacks"],
      "Resource": [
        "arn:aws:cloudformation:REPLACE_REGION:REPLACE_ACCOUNT_ID:stack/rapid-cortex-web-*/*",
        "arn:aws:cloudformation:REPLACE_REGION:REPLACE_ACCOUNT_ID:stack/rapid-cortex-v2-web-*/*"
      ]
    },
    {
      "Sid": "WebWafRead",
      "Effect": "Allow",
      "Action": [
        "wafv2:GetWebACL",
        "wafv2:GetWebACLForResource",
        "wafv2:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:wafv2:REPLACE_REGION:REPLACE_ACCOUNT_ID:global/webacl/rapid-cortex-v2-web-cdn-*/*",
        "arn:aws:wafv2:REPLACE_REGION:REPLACE_ACCOUNT_ID:global/webacl/rapid-cortex-web-*/*"
      ]
    },
    {
      "Sid": "WebCloudFrontSsr",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateResponseHeadersPolicy",
        "cloudfront:UpdateResponseHeadersPolicy",
        "cloudfront:DeleteResponseHeadersPolicy",
        "cloudfront:GetResponseHeadersPolicy",
        "cloudfront:ListResponseHeadersPolicies",
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:UpdateDistribution"
      ],
      "Resource": [
        "arn:aws:cloudfront::REPLACE_ACCOUNT_ID:response-headers-policy/*",
        "arn:aws:cloudfront::REPLACE_ACCOUNT_ID:distribution/*"
      ]
    },
    {
      "Sid": "AppCfInval",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation",
        "cloudfront:ListInvalidations"
      ],
      "Resource": "arn:aws:cloudfront::REPLACE_ACCOUNT_ID:distribution/*"
    },
    {
      "Sid": "WebElbDescribe",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DescribeLoadBalancers",
        "elasticloadbalancing:DescribeListeners",
        "elasticloadbalancing:DescribeTargetGroups",
        "elasticloadbalancing:DescribeTargetHealth"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WebElbTargetHealth",
      "Effect": "Allow",
      "Action": ["elasticloadbalancing:DescribeTargetHealth"],
      "Resource": "arn:aws:elasticloadbalancing:REPLACE_REGION:REPLACE_ACCOUNT_ID:targetgroup/rapid-cortex-v2-web-*/*"
    },
    {
      "Sid": "WebLogsRead",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents"
      ],
      "Resource": "arn:aws:logs:REPLACE_REGION:REPLACE_ACCOUNT_ID:log-group:/ecs/rapid-cortex-v2-web-*:*"
    },
    {
      "Sid": "MapboxTokenSsmRead",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:PutParameter"],
      "Resource": "arn:aws:ssm:REPLACE_REGION:REPLACE_ACCOUNT_ID:parameter/rapidcortex/prod/mapbox/public-token"
    }
  ]
}
