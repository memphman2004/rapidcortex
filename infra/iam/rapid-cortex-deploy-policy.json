{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MarketingCloudFrontInvalidation",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation",
        "cloudfront:ListInvalidations"
      ],
      "Resource": "arn:aws:cloudfront::REPLACE_ACCOUNT_ID:distribution/EWZ286WS69KX1"
    },
    {
      "Sid": "WebCodeBuildDeployRead",
      "Effect": "Allow",
      "Action": [
        "codebuild:BatchGetProjects",
        "codebuild:BatchGetBuilds",
        "codebuild:StartBuild"
      ],
      "Resource": "arn:aws:codebuild:REPLACE_REGION:REPLACE_ACCOUNT_ID:project/rapid-cortex-web-build-*"
    },
    {
      "Sid": "WebEcsDeployDescribe",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeServices",
        "ecs:DescribeTasks",
        "ecs:ListTasks"
      ],
      "Resource": [
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:service/rapid-cortex-v2-web-prod/*",
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:service/rapid-cortex-web-*/*",
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:task/rapid-cortex-v2-web-prod/*",
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:task/rapid-cortex-web-*/*"
      ]
    },
    {
      "Sid": "WebEcsClusterDiscovery",
      "Effect": "Allow",
      "Action": ["ecs:DescribeClusters", "ecs:ListServices"],
      "Resource": [
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:cluster/rapid-cortex-v2-web-prod",
        "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:cluster/rapid-cortex-web-*"
      ]
    },
    {
      "Sid": "MapboxTokenSsmRead",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter"],
      "Resource": "arn:aws:ssm:REPLACE_REGION:REPLACE_ACCOUNT_ID:parameter/rapidcortex/prod/mapbox/public-token"
    },
    {
      "Sid": "BillingSecretsCleanup",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:DeleteSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT_ID:secret:rapid-cortex/billing/ses-credentials-*",
        "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT_ID:secret:rapid-cortex/billing/payment-instructions-*"
      ]
    },
    {
      "Sid": "RapidCortexDeployManagedPolicyLifecycle",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:TagPolicy",
        "iam:UntagPolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PassRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": [
        "arn:aws:iam::REPLACE_ACCOUNT_ID:policy/rapid-cortex-*",
        "arn:aws:iam::REPLACE_ACCOUNT_ID:role/rapid-cortex-*"
      ]
    },
    {
      "Sid": "RapidCortexContinueUpdateRollback",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ContinueUpdateRollback",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackResources"
      ],
      "Resource": "arn:aws:cloudformation:REPLACE_REGION:REPLACE_ACCOUNT_ID:stack/rapid-cortex-*/*"
    }
  ]
}
